# Production origin for canonical URLs, Open Graph, robots.txt and sitemap.xml (no trailing slash).
# Example: https://lunaflowers.ru
SITE_URL=

# Optional local dev origin when SITE_URL is unset (defaults to http://localhost:5173).
# SITE_DEV_URL=http://localhost:8080

# Server-only Telegram credentials for order and contact forms.
# Add these as deployment secrets; never prefix them with VITE_ or commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
